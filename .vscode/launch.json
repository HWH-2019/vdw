{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1️⃣ VDW Plugin (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vdw-vscode",
        "${workspaceFolder}/vdw-test"
      ],
      "outFiles": [
        "${workspaceFolder}/vdw-vscode/out/**/*.js"
      ],
      "preLaunchTask": "vdw: debug prelaunch (deploy cli + watch ext)",
      "env": {
        "VDW_DEBUG": "true",
        "VDW_CLI_PATH": "${workspaceFolder}/vdw-test/vdw"
      }
    },
    {
      "name": "2️⃣ VDW CLI (Rust Debugger)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vdw-test/vdw",
      "args": ["--verbose", "init"],
      "cwd": "${workspaceFolder}/vdw-test",
      "preLaunchTask": "vdw: deploy debug to test",
      "sourceLanguages": ["rust"],
      "console": "integratedTerminal"
    },
    {
      "name": "3️⃣ VDW CLI - Link Command",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vdw-test/vdw",
      "args": ["--verbose", "link"],
      "cwd": "${workspaceFolder}/vdw-test",
      "preLaunchTask": "vdw: deploy debug to test",
      "sourceLanguages": ["rust"],
      "console": "integratedTerminal"
    },
    {
      "name": "4️⃣ VDW CLI - Validate Command",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/vdw-test/vdw",
      "args": ["--verbose", "validate"],
      "cwd": "${workspaceFolder}/vdw-test",
      "preLaunchTask": "vdw: deploy debug to test",
      "sourceLanguages": ["rust"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🔥 Joint Debug: Plugin + CLI",
      "configurations": [
        "1️⃣ VDW Plugin (Extension Host)",
        "2️⃣ VDW CLI (Rust Debugger)"
      ],
      "preLaunchTask": "vdw: deploy debug to test",
      "presentation": {
        "hidden": false,
        "group": "vdw-debug",
        "order": 1
      },
      "stopAll": true
    }
  ]
}
