{
  "name": "vdw-vscode",
  "displayName": "VDW - Virtual Dev Workspace",
  "description": "VS Code integration for VDW cross-repo development middleware",
  "version": "0.1.0",
  "publisher": "vdw-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:.vdwrc"
  ],
  "main": "./out/extension.js",
  "contributes": {
   "commands": [
      { "command": "vdw.init", "title": "VDW: Initialize Workspace" },
      { 
        "command": "vdw.linkRepo", 
        "title": "Link Repository", 
        "icon": "$(link)"
      },
      { 
        "command": "vdw.unlinkRepo", 
        "title": "Unlink Repository", 
        "icon": {
          "light": "resources/icons/unlink-light.svg",
          "dark": "resources/icons/unlink-dark.svg"
        }
      },
      { "command": "vdw.relink", "title": "VDW: Relink allRepo", "icon": "$(sync)" },
      { "command": "vdw.validate", "title": "VDW: Validate Configuration" },
      { "command": "vdw.addRepo", "title": "VDW: Add Repository", "icon": "$(add)" },
     { "command": "vdw.refreshContext", "title": "VDW: Refresh Context", "icon": "$(refresh)" },
      { 
        "command": "vdw.removeRepo", 
        "title": "Remove Repository", 
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vdw-explorer",
          "title": "VDW Workspace",
          "icon": "resources/icons/vdw.svg"
        }
      ]
    },
    "views": {
      "vdw-explorer": [
        {
          "id": "vdwWorkspace",
          "name": "Dependencies",
          "contextualTitle": "VDW Workspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vdw.addRepo",
          "when": "view == vdwWorkspace",
          "group": "navigation@1",
          "icon": "$(add)"
        },
        {
          "command": "vdw.refreshContext",
          "when": "view == vdwWorkspace",
          "group": "navigation@2",
          "icon": "$(refresh)"
        },
        {
          "command": "vdw.relink",
          "when": "view == vdwWorkspace",
          "group": "navigation@3",
          "icon": "$(sync)"
        }
      ],
      "view/item/context": [
        {
          "command": "vdw.unlinkRepo",
          "when": "view == vdwWorkspace && viewItem == linkedRepo",
          "group": "inline@1"
        },
        {
          "command": "vdw.linkRepo",
          "when": "view == vdwWorkspace && viewItem == unlinkedRepo",
          "group": "inline@1"
        },
        {
          "command": "vdw.removeRepo",
          "when": "view == vdwWorkspace && viewItem == linkedRepo",
          "group": "2@remove"
        },
        {
          "command": "vdw.removeRepo",
          "when": "view == vdwWorkspace && viewItem == unlinkedRepo",
          "group": "2@remove"
        }
      ]
    },
    "configuration": {
      "title": "VDW",
      "properties": {
        "vdw.cliPath": {
          "type": "string",
          "default": "vdw",
          "description": "Path to the VDW CLI binary"
        },
        "vdw.autoOpenGitRepositories": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open editable Git repositories in VS Code Source Control after link/relink/add operations"
        },
        "vdw.autoOpenDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay in milliseconds between opening each Git repository to avoid concurrent conflicts"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node ./out/test/runTests.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0",
    "mocha": "^10.2.0",
    "@types/mocha": "^10.0.6",
    "glob": "^10.3.10",
    "@types/glob": "^8.1.0"
  }
}
