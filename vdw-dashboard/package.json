{
  "name": "vdw-dashboard",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/manifest.mjs",
    "verify": "node scripts/manifest.mjs --verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0"
  }
}
